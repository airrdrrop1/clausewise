# Nebius Token Factory credentials — get the key from the Token Factory
# console (console.nebius.com -> Token Factory -> API keys).
# NEVER commit a real key. Without a key the app runs in mock mode.
NEBIUS_API_KEY=

# OpenAI-compatible base URL of Nebius Token Factory.
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs are namespaced and case-sensitive. Confirm the exact spellings
# available to your account first:  GET /v1/models  (Authorization: Bearer key)
# Values below are the IDs listed by other hackathon participants; treat
# them as defaults to verify, not gospel.
MODEL_NANO=nvidia/nemotron-3-nano-30b-a3b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b

# Server port
PORT=8080
